# ==============================================================================
# CONFIGURAÇÃO DO BAIAK IDLE BOT
# ==============================================================================

# 1. Token de autenticação (OBRIGATÓRIO)
# Obtenha no navegador com F12 > Application > Local Storage > https://baiakidle.com > 'baiak-idle-token'
BAIAK_TOKEN=seu_token_aqui_64_caracteres

# Token independente para os comandos administrativos remotos (/api/hunt, /api/click e /api/eval).
# Use uma senha longa e mantenha este valor igual a BOT_ADMIN_TOKEN do monitor privado.
ADMIN_TOKEN=troque_por_um_token_admin_longo

# 2. Exibição do Navegador
# HEADLESS=false abre a janela do jogo na sua tela (ideal para PC comum)
# HEADLESS=true roda sem janela em segundo plano (ideal para VPS ou segundo plano)
HEADLESS=false

# 3. Automações do Jogo (true para ativar, false para desativar)
AUTO_HUNT=true
# Sempre fica / volta para a última hunt (HUD ou pick-current do jogo).
# HUNT_ID só é usado se FORCE_HUNT=true — não escolhe hunt sozinho.
FORCE_HUNT=false
HUNT_ID=
# Renderização GL: swiftshader (WebGL via software, sem GPU — recomendado) ou off.
# 'off' mata WebGL e é um forte indicador de bot para o anti-cheat. Use 'off' só em teste.
CHROME_GL=swiftshader
AUTO_TREINO=true
AUTO_SELL=true
SELL_THRESHOLD_PCT=75
AUTO_BOSS=true
AUTO_BAGS=true
AUTO_EQUIP=true
AUTO_PREY=true
AUTO_EXTRAS=true
REDUCE_VFX=true

# 4. Cura e Poções Automáticas (Helper / In-game)
# Configura automaticamente magia de cura e as melhores poções de HP/Mana desbloqueadas
AUTO_HEAL=true
HEAL_BELOW_PCT=75
HP_POTION_BELOW_PCT=60
MANA_POTION_BELOW_PCT=65

# 4. Captura de tela periódica em data/screenshot.png (0 = desativado)
SCREENSHOT_INTERVAL=0

# 5. Transmissão 480p no dashboard (MJPEG, sem ffmpeg). LIVE_STREAM=false desliga.
LIVE_STREAM=true
STREAM_FPS=12
STREAM_WIDTH=854
STREAM_HEIGHT=480
STREAM_QUALITY=70
