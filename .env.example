# Token de autenticação da sua conta Baiak Idle (F12 > Application > Local Storage > baiak-idle-token)
BAIAK_TOKEN=

# Configurações do Navegador
HEADLESS=true
CHROME_GL=swiftshader
# CHROME_PATH=  # Deixe em branco para autodetecção do Chromium/Playwright

# Automações de Gameplay
AUTO_HUNT=true
HUNT_MODE=last
HUNT_ID=
FORCE_HUNT=false
AUTO_TREINO=true
AUTO_SELL=true
SELL_THRESHOLD_PCT=70
AUTO_BOSS=true
AUTO_EQUIP=true
AUTO_BAGS=true
AUTO_PREY=true
AUTO_EXTRAS=true

# Cura e Poções
AUTO_HEAL=true
HEAL_BELOW_PCT=75
HP_POTION_BELOW_PCT=60
MANA_POTION_BELOW_PCT=65

# Redução de efeitos para economizar CPU
REDUCE_VFX=true

# Servidor Web e Transmissão ao Vivo
PORT=8080
HOST=0.0.0.0
LIVE_STREAM=true
STREAM_FPS=12
STREAM_WIDTH=854
STREAM_HEIGHT=480
STREAM_QUALITY=70

# Leilão / Arbitragem (JEV - VPS 2)
AUCTION_ENABLED=true
AUCTION_LIVE=true
AUCTION_BUDGET=100
AUCTION_MIN_GOLD_PER_COIN=7000000
AUCTION_SELL_GOLD=800000000
AUCTION_SELL_ENABLED=false
AUCTION_MARGIN=20
AUCTION_SNIPER_MAX_MINS=5
JEV_ENABLED=true
JEV_AUTO_HUNT=false
TYPESAFE_API_KEY=

# ===== Driver terminal (src/term/main.ts) — sem Chromium, sem Xvfb =====
# O driver lê só as variáveis abaixo; o resto da lista acima é do modo navegador.

# Obrigatório. F12 > Application > Local Storage > baiak-idle-token
# (BAIAK_TOKEN no topo já serve; repetido aqui só para clareza)
# BAIAK_TOKEN=

CHARACTER_NAME=
# HUNT_ID=          # hunt fixa; vazio = melhor hunt para o nível
# TERM_ORIGIN=https://baiakidle.com
USER_DATA_DIR=./data

# Automações do terminal (o prefixo é a lista de flags --no-* correspondentes)
AUTO_SELL=true
AUTO_REWARDS=true
AUTO_TREINO=true
AUTO_ARENA=true
AUTO_CODEX=true
AUTO_EQUIP=true       # equipa itens da mochila a cada 5 min
EQUIP_MIN_TIER=3      # 1=common .. 3=épico .. 7=legendary
AUTO_LOOP=true
AUTO_TREE=true
AUTO_BOSS=false

# Painel HTTP (leitura livre; escrita exige loopback ou CONTROL_TOKEN)
CONTROL_HOST=127.0.0.1
CONTROL_PORT=8080
# CONTROL_TOKEN=      # se expuser 0.0.0.0/VPN, preencha para permitir POST

