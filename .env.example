# ==============================================================================
# CONFIGURAÇÃO DO BAIAK IDLE BOT
# ==============================================================================

# 1. Token de autenticação (OBRIGATÓRIO)
# Obtenha no navegador com F12 > Application > Local Storage > https://baiakidle.com > 'baiak-idle-token'
BAIAK_TOKEN=seu_token_aqui_64_caracteres

# 2. Exibição do Navegador
# HEADLESS=false abre a janela do jogo na sua tela (ideal para PC comum)
# HEADLESS=true roda sem janela em segundo plano (ideal para VPS ou segundo plano)
HEADLESS=false

# 3. Automações do Jogo (true para ativar, false para desativar)
AUTO_HUNT=true
HUNT_ID=
AUTO_TREINO=true
AUTO_SELL=true
SELL_THRESHOLD_PCT=75
AUTO_BOSS=true
AUTO_BAGS=true
AUTO_EQUIP=true
AUTO_PREY=true
AUTO_EXTRAS=true
REDUCE_VFX=true

# 4. Captura de tela periódica em data/screenshot.png (0 = desativado)
SCREENSHOT_INTERVAL=0
