# Endereços internos das duas VPS. Não publique estes valores no GitHub Pages.
VPS1_URL=http://host.docker.internal:8080
VPS2_URL=http://137.131.226.117:8080

# O GitHub Pages só acessa /api/public/overview, em modo leitura.
PUBLIC_ORIGIN=https://kbelludoo.github.io
SNAPSHOT_INTERVAL_MS=10000

# Opcional: URL de webhook Slack/Discord para alertas de API, atraso ou bot offline.
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MS=900000

# Necessários somente para comandos no painel operacional privado.
# BOT_ADMIN_TOKEN deve ser exatamente igual ao ADMIN_TOKEN de cada bot.
OPERATOR_TOKEN=troque_por_um_token_de_operador_longo
BOT_ADMIN_TOKEN=troque_por_o_mesmo_token_admin_dos_bots
